# ── Backend ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (Postgres — docker-compose defaults)
DATABASE_URL=postgresql://adm:adm_secret@localhost:5432/adm_taxi?schema=public

# Redis (real-time presence / geo)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:8081,http://localhost:19006

# SMS (OTP) provayderi: console (dev) | eskiz | playmobile
SMS_PROVIDER=console
# Eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Play Mobile
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_FROM=3700
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz/broker-api

# ── Xarita / marshrut / geokoder ─────────────────────────
# Standart: OSRM (bepul, kalitsiz) + Nominatim (bepul, kalitsiz)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_COUNTRY=uz
# Ixtiyoriy — yuqori aniqlik uchun Yandex kaliti (bo'lsa avtomatik ishlatiladi)
YANDEX_API_KEY=

# ── Frontends ────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
# Frontend xaritada Yandex JS API kaliti (ixtiyoriy; bo'lmasa OSM/Leaflet)
VITE_YANDEX_API_KEY=
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000
