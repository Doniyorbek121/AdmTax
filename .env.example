# ── Backend ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (Postgres — docker-compose defaults)
DATABASE_URL=postgresql://adm:adm_secret@localhost:5432/adm_taxi?schema=public

# Redis (real-time presence / geo)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006

# SMS (OTP) — provider stub; log codes to console in dev
SMS_PROVIDER=console

# ── Frontends ────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000
