{
  "name": "adm-taxi",
  "version": "0.1.0",
  "private": true,
  "description": "ADM Taksi — to'liq taksi buyurtma platformasi (backend, admin, operator, haydovchi, yo'lovchi)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @adm/backend",
    "dev:admin": "npm run dev --workspace @adm/admin-web",
    "dev:operator": "npm run dev --workspace @adm/operator-web",
    "dev:passenger": "npm run dev --workspace @adm/passenger-app",
    "dev:driver": "npm run dev --workspace @adm/driver-app",
    "build:shared": "npm run build --workspace @adm/shared",
    "build": "npm run build --workspaces --if-present",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
